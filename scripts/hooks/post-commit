#!/usr/bin/env bash
# Depois de cada commit: regenera o README e o inclui no proprio commit (amend).
cd "$(git rev-parse --show-toplevel)"
[ -n "${LANIS_README_AMEND:-}" ] && exit 0

bash scripts/gen-readme.sh
if ! git diff --quiet -- README.md; then
  git add README.md
  LANIS_README_AMEND=1 git commit --amend --no-edit --no-verify -q
fi
